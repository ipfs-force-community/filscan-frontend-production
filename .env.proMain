NEXT_PUBLIC_NODE_ENV=production
NEXT_PUBLIC_PORT=9098
NEXT_PUBLIC_environment=mainner
NEXT_PUBLIC_NET_WORK=Mainnet
# 静态资源基地址（logo/钱包图标等 images 资源），默认留空 = 本地资源（/images/xxx，放 public/images 或由 nginx 提供）
# OSS 配置示例（取消注释即启用 OSS）：
# NEXT_PUBLIC_STATIC_URL='https://filscan-v2.oss-accelerate.aliyuncs.com/fvm_manage'
NEXT_PUBLIC_STATIC_URL=
# 构建产物（_next/*）资源前缀，默认留空 = 本地（/_next/static/...，由 Next.js server 或 nginx 提供）
# OSS 配置示例（取消注释即启用 OSS）：
# NEXT_PUBLIC_ASSET_PREFIX='https://filscan-v2.oss-accelerate.aliyuncs.com/client'
NEXT_PUBLIC_ASSET_PREFIX=
NEXT_PUBLIC_APP_BASE_URL=https://api-v2.filscan.io/api/v1
NEXT_PUBLIC_APP_BASE_URL_PRO=http://8.217.144.232:29000/pro/v1